<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50"/>
    </ItemGroup>

    <!-- Protobuf. `Google.Protobuf` is the only runtime dependency any shipped
         package takes, and it is deliberately pinned low — see the floor policy
         in src/CS2OpenDev.Protos/README.md. Because CS2OpenDev.Protos exposes
         generated `IMessage` types on its public surface, this version is an ABI
         commitment: every consumer is bound to a compatible major, and raising
         the floor is a breaking change for anyone pinned below it.

         `Grpc.Tools` is build-only (protoc + the MSBuild integration) and never
         reaches a consumer, so it tracks latest rather than a conservative
         floor. -->
    <ItemGroup>
        <PackageVersion Include="Google.Protobuf" Version="3.27.0"/>
        <PackageVersion Include="Grpc.Tools" Version="2.83.0"/>
    </ItemGroup>

    <!-- Testing Project Specific Packages-->
    <ItemGroup>
        <PackageVersion Include="TUnit" Version="1.45.0"/>
    </ItemGroup>
</Project>
