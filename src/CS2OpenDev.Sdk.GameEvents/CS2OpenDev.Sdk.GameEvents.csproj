<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AssemblyName>CS2OpenDev.Sdk.GameEvents</AssemblyName>
        <RootNamespace>CS2OpenDev.Sdk.GameEvents</RootNamespace>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Generated/ is exporter output, written to the same conventions as
             src/CS2OpenDev.Sdk. It carries the schema's own naming (underscored
             KV1 keys, C++-flavoured type names), so the same analyzer carve-outs
             the SDK needs apply. -->
        <NoWarn>$(NoWarn);CA1707;CA1711;CA1720</NoWarn>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>portable</DebugType>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

        <PackageId>CS2OpenDev.Sdk.GameEvents</PackageId>
        <Authors>CS2OpenDev Contributors</Authors>
        <Description>
            Decodes Counter-Strike 2's legacy game-event wire messages
            (CMsgSource1LegacyGameEvent) into the strongly-typed event records shipped by
            CS2OpenDev.Sdk. Includes the event-name to factory registry and a per-fire envelope
            carrying demo transport context.
        </Description>
        <PackageTags>cs2;counter-strike;demo;game-events;source2;protobuf</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- Schema provenance, in the same three places CS2OpenDev.Sdk puts it.

         The release matrix already marks this package `schema_metadata: true`
         and passes `-p:CS2SchemaRevision` / `-p:CS2SchemaDate` to pack. Until
         this block existed nothing consumed them, so the properties were set
         and silently dropped: CS2OpenDev.Sdk.GameEvents 2.0.10 shipped as a
         bare `2.0.10` while CS2OpenDev.Sdk 2.0.4 carried
         `+cs.24537688.dump.2026-08-03`.

         That gap mattered more here than it would have on the SDK. Event
         records are generated from `gameevents_schema.json`, whose field sets
         change between CS2 builds — `player_death` gained four fields in this
         very release — so "which build were these records generated from" is a
         question a consumer of THIS package has to be able to answer offline.

         See CS2OpenDev.Sdk.csproj for why the same facts are recorded three
         times: SemVer 2 build metadata is stripped by some feeds, so
         AssemblyMetadata (inside the DLL) and PackageReleaseNotes (on the
         listing page) carry it where it cannot be lost. All conditional, so a
         local `dotnet pack` passing neither property omits them rather than
         emitting empty values. -->
    <ItemGroup>
        <BuildMetadata Include="cs.$(CS2SchemaRevision)"
                       Condition="'$(CS2SchemaRevision)' != ''"/>
        <BuildMetadata Include="dump.$(CS2SchemaDate)"
                       Condition="'$(CS2SchemaDate)' != ''"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="CS2SchemaRevision"
                          Value="$(CS2SchemaRevision)"
                          Condition="'$(CS2SchemaRevision)' != ''"/>
        <AssemblyMetadata Include="CS2SchemaDumpDate"
                          Value="$(CS2SchemaDate)"
                          Condition="'$(CS2SchemaDate)' != ''"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The decoder's input type is a protobuf message, so this package takes
             the Google.Protobuf dependency that CS2OpenDev.Sdk deliberately does
             not. That split is the whole reason this is a separate package:
             consumers who only want schema types keep a zero-dependency SDK. -->
        <ProjectReference Include="../CS2OpenDev.Protos/CS2OpenDev.Protos.csproj"/>
        <ProjectReference Include="../CS2OpenDev.Sdk/CS2OpenDev.Sdk.csproj"/>
    </ItemGroup>
</Project>
