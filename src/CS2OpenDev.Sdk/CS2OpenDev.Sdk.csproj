<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AssemblyName>CS2OpenDev.Sdk</AssemblyName>
        <RootNamespace>CS2OpenSchema</RootNamespace>

        <!-- Suppressions that an empirical scan of the generator output proved we
             still need (analyzer fires at least once with the current schema).
             Reasons follow the C++/schema convention the generator is preserving.
             Dropped from this list after Step 7's audit because the current output
             no longer trips them:
               CS8618 / CS0108 — covered by file-level `#pragma warning disable`.
               CA1061          — no cross-hierarchy hiding fires on real schema.
               CA1708          — NH-3 disambiguates case-only collisions by name.
               CA1716          — Common namespace replaces Shared (CA1716 root). -->
        <!-- CA1069 : duplicate enum values — intentional C++ sentinel/alias members -->
        <!-- CA1707 : underscores in names (stub `_t` suffix, etc.) — C++ convention -->
        <!-- CA1711 : names ending in Enum/Flag/Attribute/Queue/Stack — C++ type names -->
        <!-- CA1712 : enum member prefixed with type name — C++ enum naming convention -->
        <!-- CA1720 : identifier contains type name (Int8, Float, …) — C++ scalar names -->
        <!-- Extend (don't replace) the parent Directory.Build.props NoWarn list,
             which already silences CS1591 for the (very large) generated SDK. -->
        <NoWarn>$(NoWarn);CA1069;CA1707;CA1711;CA1712;CA1720</NoWarn>

        <!-- Emit the XML docs file so NuGet consumers get IntelliSense -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Produce a `.snupkg` symbols package alongside the `.nupkg` so
             consumers can step into the SDK with a debugger when needed.
             `snupkg` (NuGet's modern symbols format) carries portable PDBs +
             a symbols manifest; the matching `.nupkg` carries the assemblies
             and stays free of debug bloat. NuGet.org's symbol server then
             serves the PDBs to clients that have it configured.

             The publish flow pushes both files in one `dotnet nuget push`
             call against a `*.nupkg` glob — NuGet's push step auto-pairs
             a `.snupkg` next to each `.nupkg` and uploads it to the
             symbol server. -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>portable</DebugType>

        <!-- Normalise the absolute build paths that would otherwise be baked
             into the shipped binaries. Two places leak them without this:

               1. The assembly's debug directory (CodeView / `RSDS` record) in
                  `lib/net8.0/CS2OpenDev.Sdk.dll`, which stores where the PDB
                  lived at build time — it ships even though the PDB doesn't.
               2. The SourceLink document map inside the PDB in the `.snupkg`,
                  which is published to NuGet.org's public symbol server.

             v1.0.2 shipped `/Users/<user>/Development/CS2OpenDev-SDK/…` in
             both, disclosing the packer's OS username and home layout to
             every downstream consumer that redistributes the assembly.
             `DeterministicSourcePaths` (which this property enables) rewrites
             the repo root to `/_/`, so the recorded paths keep their shape and
             stack traces stay usable — unlike `DebugType=none`, which would
             drop the debug directory entirely and hollow out the `.snupkg`.

             Deliberately NOT gated on CI: `dotnet pack` run from a developer
             machine has to normalise paths too, or the leak walks straight
             back in on the next hand-packed release. The pack workflow's
             "Assert no build-machine paths" step enforces this either way. -->
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

        <!-- NuGet package identity -->
        <PackageId>CS2OpenDev.Sdk</PackageId>
        <!-- Version is supplied by Nerdbank.GitVersioning (`version.json`).
             MAJOR.MINOR live in `version.json` and are bumped intentionally;
             PATCH increments automatically with each commit that touches files
             matched by `pathFilters` (currently `src/CS2OpenDev.Sdk/`), so every
             SDK regen produces a new monotone version. The CS2 schema revision
             and dump date are appended as SemVer 2 build metadata at pack-time
             by the `AddSchemaBuildMetadata` target below. -->
        <Authors>CS2OpenDev Contributors</Authors>
        <Description>
            C# SDK generated from the CS2 Windows schema dump. Provides strongly-typed classes,
            enums, and structs for every type reflected by CS2's schema system, with native
            field names and byte offsets preserved as attributes for interop use.
        </Description>
        <PackageTags>cs2;counter-strike;schema;sdk;interop</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- Appends SemVer 2 build metadata (`+cs.{revision}.dump.{yyyy-MM-dd}`)
         to the package version when CI passes CS2 schema revision and dump
         date via MSBuild properties:

             dotnet pack ... \
                 -p:CS2SchemaRevision=10673343 \
                 -p:CS2SchemaDate=2026-05-20

         Local `dotnet pack` without these properties produces a clean
         `1.0.42` version — no build metadata, no failure.

         The items MUST live in a top-level `<ItemGroup>` rather than inside
         a Target. NB.GV computes the version in a separate sub-project
         (`PrivateP2PCaching.proj`) invoked via P2P, and items defined in a
         `BeforeTargets="GetBuildVersion"` target in *this* csproj are never
         visible to that sub-project. Static items declared here ARE passed
         through because MSBuild evaluates them before the P2P call.

         Date format must be ISO (no spaces) per the SemVer 2 identifier
         grammar `[0-9A-Za-z-]+`; schema 2.0 headers already carry the date as
         ISO ("2026-05-20"), and the read-schema-metadata action validates the
         shape before invoking pack. -->
    <ItemGroup>
        <BuildMetadata Include="cs.$(CS2SchemaRevision)"
                       Condition="'$(CS2SchemaRevision)' != ''"/>
        <BuildMetadata Include="dump.$(CS2SchemaDate)"
                       Condition="'$(CS2SchemaDate)' != ''"/>
    </ItemGroup>

    <!-- The same schema revision + dump date, recorded in two places that do
         NOT depend on the version string surviving intact.

         SemVer 2 build metadata (the `+cs.…` above) is the fragile channel:
         it is not part of a NuGet package's identity, it never appears in the
         `.nupkg` filename, and feeds are inconsistent about preserving it —
         GitHub Packages in particular has a long-standing bug where a `+`
         version is registered but then requested from a URL without the
         metadata. So the same facts are duplicated where they cannot be
         stripped:

           1. `AssemblyMetadata` — emitted as `[assembly: AssemblyMetadata]`
              attributes, so the values travel inside the DLL itself and are
              readable by reflection or any metadata reader, forever,
              regardless of how the package was obtained:

                  typeof(CS2OpenSchema.Attributes.SchemaClassAttribute).Assembly
                      .GetCustomAttributes<AssemblyMetadataAttribute>()
                      .First(a => a.Key == "CS2SchemaRevision").Value

              or, without loading it: `ikdasm` / `monodis`, or
              `strings CS2OpenDev.Sdk.dll | grep CS2Schema`.

           2. `PackageReleaseNotes` — surfaced on the NuGet.org and GitHub
              Packages listing pages, so the provenance is visible before
              downloading anything.

         Both are conditional: a local `dotnet pack` that passes neither
         property omits them rather than emitting empty values. Note this
         widens the existing local-vs-CI binary divergence — a CI pack already
         differs from a local one via AssemblyInformationalVersion — which is
         why the two feeds are fed from a single pack rather than one each. -->
    <ItemGroup>
        <AssemblyMetadata Include="CS2SchemaRevision"
                          Value="$(CS2SchemaRevision)"
                          Condition="'$(CS2SchemaRevision)' != ''"/>
        <AssemblyMetadata Include="CS2SchemaDumpDate"
                          Value="$(CS2SchemaDate)"
                          Condition="'$(CS2SchemaDate)' != ''"/>
    </ItemGroup>

    <PropertyGroup>
        <PackageReleaseNotes Condition="'$(CS2SchemaRevision)' != '' Or '$(CS2SchemaDate)' != ''">Generated from CS2 schema revision $(CS2SchemaRevision) (dump $(CS2SchemaDate)). The same values are available as AssemblyMetadata attributes on the shipped assembly, under the keys CS2SchemaRevision and CS2SchemaDumpDate.</PackageReleaseNotes>
    </PropertyGroup>
</Project>
